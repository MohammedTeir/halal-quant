//@version=6
strategy("HALAL QUANT — Trend-Aligned Gold Breakout", overlay=true, pyramiding=0, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.10, slippage=2, process_orders_on_close=false, calc_on_every_tick=false, calc_on_order_fills=false)
// Research-only technical candidates. No compliance or execution authorization.
startDate = input.time(timestamp("01 Jan 2020 00:00 +0000"), "Start date (UTC)")
endDate = input.time(timestamp("01 Jan 2035 00:00 +0000"), "End date (UTC)")
atrLen = input.int(14, "ATR length", minval=1)
stopMult = input.float(2.0, "Initial stop ATR", minval=0.1)
trailMult = input.float(3.0, "Trailing stop ATR", minval=0.1)
allowEntries = input.bool(true, "Enable research entries")
// Cost assumptions are editable in Strategy Properties, never optimized away.
atrValue = ta.atr(atrLen)
inWindow = time_close >= startDate and time_close <= endDate
payload(string action) =>
    string eventId = "breakout_retest|" + syminfo.tickerid + "|" + timeframe.period + "|" + str.tostring(time_close) + "|" + action
    string stamp = str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
    '{"schema_version":"1.0","event_id":"' + eventId + '","strategy":"breakout_retest","strategy_version":"1.0.0","asset_class":"gold","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","action":"' + action + '","bar_time":"' + stamp + '","price":' + str.tostring(close, format.mintick) + '}'
trendTimeframe = input.timeframe("D", "Higher trend timeframe")
fastLen = input.int(50, "Higher trend EMA", minval=2)
slowLen = input.int(200, "Higher long EMA", minval=3)
channelLen = input.int(20, "Donchian lookback", minval=2)
adxLen = input.int(14, "ADX / DI length", minval=2)
adxMinimum = input.float(20, "Minimum ADX", minval=0)
volatilityCap = input.float(3.0, "Maximum ATR / price (%)", minval=0.1)
requireRetest = input.bool(true, "Require retest")
retestBars = input.int(5, "Retest expiry bars", minval=1)
retestTolerance = input.float(0.25, "Retest tolerance (ATR)", minval=0)
if timeframe.in_seconds(trendTimeframe) <= timeframe.in_seconds()
    runtime.error("Trend timeframe must be higher than chart timeframe")
[htfFast, htfSlow, htfWarm] = request.security(syminfo.tickerid, trendTimeframe, [ta.ema(close, fastLen)[1], ta.ema(close, slowLen)[1], bar_index[1] >= slowLen], lookahead=barmerge.lookahead_on)
channel = ta.highest(high, channelLen)[1]
[plusDI, minusDI, adxValue] = ta.dmi(adxLen, adxLen)
breakout = ta.crossover(close, channel)
var float pendingLevel = na
var int pendingBar = na
bool retested = false
if barstate.isconfirmed
    if not na(pendingBar)
        if bar_index - pendingBar > retestBars or close < pendingLevel - atrValue * retestTolerance
            pendingLevel := na
            pendingBar := na
        else if bar_index > pendingBar and low <= pendingLevel + atrValue * retestTolerance and close > pendingLevel
            retested := true
            pendingLevel := na
            pendingBar := na
    if breakout and not retested
        pendingLevel := channel
        pendingBar := bar_index
warm = bar_index >= math.max(channelLen, 2 * adxLen) and htfWarm and not na(atrValue)
entryCondition = htfFast > htfSlow and adxValue >= adxMinimum and atrValue / close * 100 <= volatilityCap and (requireRetest ? retested : breakout)
trendExit = htfFast <= htfSlow
plot(channel, "Previous Donchian high", color=color.blue)

var float stopPrice = na
var float peak = na
if barstate.isconfirmed
    if strategy.position_size == 0 and strategy.position_size[1] > 0
        alert(payload("EXIT_CANDIDATE"), alert.freq_once_per_bar_close)
        stopPrice := na
        peak := na
    if strategy.position_size > 0
        peak := math.max(nz(peak, high), high)
        stopPrice := math.max(nz(stopPrice, strategy.position_avg_price - stopMult * atrValue), peak - trailMult * atrValue)
        strategy.exit("Protective", "Long", stop=stopPrice, disable_alert=true)
        if trendExit or time_close > endDate
            strategy.close("Long", disable_alert=true)
    // Do not reenter on a bar that already contained an exit.
    if allowEntries and inWindow and warm and atrValue > 0 and close - stopMult * atrValue > 0 and entryCondition and strategy.position_size == 0 and strategy.closedtrades == nz(strategy.closedtrades[1])
        stopPrice := close - stopMult * atrValue
        peak := close
        strategy.entry("Long", strategy.long, disable_alert=true)
        // Attach the initial protective order immediately to the pending entry.
        strategy.exit("Protective", "Long", stop=stopPrice, disable_alert=true)
        alert(payload("ENTRY_CANDIDATE"), alert.freq_once_per_bar_close)
plot(strategy.position_size > 0 ? stopPrice : na, "Research stop", color=color.red, style=plot.style_linebr)
