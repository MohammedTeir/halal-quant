{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "symbol": {
      "minLength": 1,
      "title": "Symbol",
      "type": "string"
    },
    "asset_class": {
      "enum": [
        "stock",
        "etf",
        "gold"
      ],
      "title": "Asset Class",
      "type": "string"
    },
    "timeframe_seconds": {
      "exclusiveMinimum": 0,
      "title": "Timeframe Seconds",
      "type": "integer"
    },
    "price_basis": {
      "enum": [
        "split_adjusted",
        "total_return_adjusted",
        "unadjusted"
      ],
      "title": "Price Basis",
      "type": "string"
    },
    "volume_basis": {
      "default": "as_reported",
      "enum": [
        "as_reported",
        "split_adjusted"
      ],
      "title": "Volume Basis",
      "type": "string"
    },
    "adjustment_rounding_quantum": {
      "anyOf": [
        {
          "maximum": 0.01,
          "minimum": 1e-08,
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adjustment Rounding Quantum"
    },
    "quote_basis": {
      "anyOf": [
        {
          "enum": [
            "bid",
            "ask",
            "mid",
            "trade"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote Basis"
    },
    "volume_semantics": {
      "anyOf": [
        {
          "enum": [
            "provider_reported",
            "unavailable_zero_placeholder"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Volume Semantics"
    },
    "currency": {
      "const": "USD",
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    },
    "timestamp_semantics": {
      "const": "bar_close",
      "default": "bar_close",
      "title": "Timestamp Semantics",
      "type": "string"
    }
  },
  "required": [
    "source",
    "symbol",
    "asset_class",
    "timeframe_seconds",
    "price_basis",
    "retrieved_at"
  ],
  "title": "DataSpec",
  "type": "object"
}
