{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 2000,
          "minLength": 8,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Event Id",
      "type": "string"
    },
    "symbol": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:/-]+$",
      "title": "Symbol",
      "type": "string"
    },
    "asset_class": {
      "enum": [
        "stock",
        "etf",
        "gold"
      ],
      "title": "Asset Class",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "earnings",
        "company",
        "fed",
        "cpi",
        "employment",
        "other"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "sentiment": {
      "enum": [
        "positive",
        "negative",
        "neutral",
        "mixed"
      ],
      "title": "Sentiment",
      "type": "string"
    },
    "sentiment_score": {
      "maximum": 1,
      "minimum": -1,
      "title": "Sentiment Score",
      "type": "number"
    },
    "relevance": {
      "maximum": 1,
      "minimum": 0,
      "title": "Relevance",
      "type": "number"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Severity",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "source_ids": {
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 40,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "market_impact": {
      "enum": [
        "positive",
        "negative",
        "neutral",
        "uncertain"
      ],
      "title": "Market Impact",
      "type": "string"
    },
    "recommended_policy": {
      "enum": [
        "ALLOW",
        "REVIEW",
        "RESTRICT"
      ],
      "title": "Recommended Policy",
      "type": "string"
    },
    "requires_human_review": {
      "title": "Requires Human Review",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "symbol",
    "asset_class",
    "event_type",
    "sentiment",
    "sentiment_score",
    "relevance",
    "severity",
    "confidence",
    "source_ids",
    "evidence",
    "market_impact",
    "recommended_policy",
    "requires_human_review"
  ],
  "title": "Assessment",
  "type": "object"
}
