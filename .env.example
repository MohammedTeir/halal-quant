DATABASE_URL=postgresql+psycopg://halal:halal@localhost:5432/halal_quant
# Set distinct, random credentials outside source control. Empty values deny all access.
DASHBOARD_API_KEY=
TRADINGVIEW_WEBHOOK_KEY=
DATA_INGESTION_KEY=
ANALYSIS_API_KEY=
# Optional provider IDs for research snapshots; blank means unconfigured.
# NEWS_PROVIDER=your_provider
# CALENDAR_PROVIDER=your_provider
# Internal synthetic paper simulator; enable only on a reviewed test deployment.
PAPER_TRADING_ENABLED=false
# Separate opt-in for reviewed, internal forward simulation with read-only market data.
PAPER_FORWARD_ENABLED=false
# Live execution is unsupported and must remain false.
LIVE_TRADING_ENABLED=false

# Project backend Gemini adapter. Optional and disabled until explicitly enabled.
GEMINI_ENABLED=false
GEMINI_API_KEY=
# Set a JSON-output-capable model ID available in your Google AI Studio account.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=4096

# Optional read-only research acquisition; do not commit real keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=

# Optional earnings facts selector; requires scoped imported coverage.
# EARNINGS_PROVIDER=finnhub_earnings

# Official FOMC calendar selector after acquiring source data.
# FOMC_PROVIDER=federal_reserve

# Optional controls roles. Distinct from every other API credential; blank denies access.
CONTROLS_REVIEWER_KEY=
CONTROLS_OPERATOR_KEY=
CONTROLS_BROKER_KEY=
# Real named identities must be configured before reviewer/operator writes.
CONTROLS_REVIEWER_IDENTITY=
CONTROLS_OPERATOR_IDENTITY=

# Human accounts: HTTPS cookies stay secure in production. False is localhost-only.
SESSION_COOKIE_SECURE=true
SESSION_HOURS=12
PUBLIC_BASE_URL=https://localhost
# Supply via server secret manager to the Telegram worker, never browser/Git.
TELEGRAM_BOT_TOKEN=
