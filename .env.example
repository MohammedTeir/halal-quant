DATABASE_URL=postgresql+psycopg://halal:halal@localhost:5432/halal_quant
# Set distinct, random credentials outside source control. Empty values deny all access.
DASHBOARD_API_KEY=
TRADINGVIEW_WEBHOOK_KEY=
DATA_INGESTION_KEY=
ANALYSIS_API_KEY=
# Optional provider IDs for research snapshots; blank means unconfigured.
# NEWS_PROVIDER=your_provider
# CALENDAR_PROVIDER=your_provider
# Live execution is unsupported and must remain false.
LIVE_TRADING_ENABLED=false

# Project backend Gemini adapter. Optional and disabled until explicitly enabled.
GEMINI_ENABLED=false
GEMINI_API_KEY=
# Set a JSON-output-capable model ID available in your Google AI Studio account.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=4096

# Optional read-only research acquisition; do not commit real keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=

# Optional earnings facts selector; requires scoped imported coverage.
# EARNINGS_PROVIDER=finnhub_earnings
